# Database Connection (Laravel Pattern)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_management
DB_USERNAME=root
DB_PASSWORD=

# Optional Pool Configuration
DB_CONNECTION_LIMIT=10
DB_CHARSET=utf8mb4

# Redis Configuration (Laravel Pattern)
REDIS_CLIENT=ioredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth / Session Configuration
SESSION_SECRET=project-management-super-secret-session-key-change-in-prod

# LDAP Configuration (Laravel / LdapRecord Pattern)
LDAP_CACHE=false
LDAP_LOGGING=true
LDAP_CONNECTION=default
LDAP_HOST=127.0.0.1
LDAP_USERNAME="cn=admin,dc=example,dc=com"
LDAP_PASSWORD="secret"
LDAP_PORT=389
LDAP_BASE_DN="dc=example,dc=com"
LDAP_TIMEOUT=5
LDAP_SSL=false
LDAP_TLS=false
LDAP_SASL=false
