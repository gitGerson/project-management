# Database Connection (Laravel Pattern)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_management
DB_USERNAME=root
DB_PASSWORD=

# Optional Pool Configuration
DB_CONNECTION_LIMIT=10
DB_CHARSET=utf8mb4

# Auth / Session Configuration
SESSION_SECRET=project-management-super-secret-session-key-change-in-prod
